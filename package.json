    "record": "tsx scripts/record-runs.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chrono-node": "^2.8.4",
    "next": "^15.5.4",
    "openai": "^5.23.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "unpdf": "^1.3.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^17.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
