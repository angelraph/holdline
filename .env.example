# Nebius Token Factory (https://tokenfactory.nebius.com) — required for live runs
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Tavily (https://tavily.com) — live regulation fetch, citation checks, help finder
TAVILY_API_KEY=

# Model roles. Leave blank to auto-pick from GET /v1/models (run `npm run models` to see the list).
MODEL_VISION=
MODEL_FAST=
MODEL_COMPOSE=
MODEL_REASON=
